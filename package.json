  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "prettier": "prettier --write --ignore-unknown .",
    "clean": "rimraf node_modules pnpm-lock.yaml",
