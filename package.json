{
  "name": "utils",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "volta": {
    "node": "22.17.0"
  },
  "pnpm": {
    "overrides": {
      "on-headers": ">=1.1.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "prettier": "prettier --write --ignore-unknown .",
    "clean": "rimraf node_modules pnpm-lock.yaml",
    "validate": "turbo validate",
    "storybook": "turbo storybook",
    "build-storybook": "turbo build-storybook",
    "dev": "turbo dev",
    "sherif": "pnpm dlx sherif -r unsync-similar-dependencies",
    "sherif:fix": "pnpm run sherif --fix -r unsync-similar-dependencies"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/browser": "^4.0.4",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/ui": "^4.0.4",
    "eslint": "^9.38.0",
    "eslint-config-ts-prefixer": "^4.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "private": true
}
