    "storybook": "turbo storybook",
    "build-storybook": "turbo build-storybook",
    "dev": "turbo dev",
    "sherif": "pnpm dlx sherif -r unsync-similar-dependencies",
    "sherif:fix": "pnpm run sherif --fix -r unsync-similar-dependencies"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/browser": "^4.0.10",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-config-ts-prefixer": "^4.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
