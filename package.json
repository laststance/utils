{
  "name": "utils",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "overrides": {
      "on-headers": ">=1.1.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "prettier": "prettier --ignore-unknown --write .",
    "clean": "rimraf node_modules .turbo pnpm-lock.yaml packages/*/node_modules packages/*/.turbo",
    "clean:build": "rimraf packages/*/.next packages/*/dist packages/*/storybook-static packages/*/coverage",
    "clean:all": "pnpm clean && pnpm clean:build",
    "validate": "turbo validate",
    "storybook": "turbo storybook",
    "build-storybook": "turbo build-storybook",
    "dev": "turbo dev",
    "sherif": "pnpm dlx sherif -r unsync-similar-dependencies",
    "sherif:fix": "pnpm run sherif --fix -r unsync-similar-dependencies",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.8.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
